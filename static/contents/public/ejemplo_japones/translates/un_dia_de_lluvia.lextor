{
 "format": "lextor/1",
 "meta": {
  "title": "雨の日",
  "title_translation": "Un día de lluvia",
  "text_lang": "ja",
  "notes_lang": "es",
  "level": "A2",
  "summary": "Una tarde tranquila en casa mientras llueve.",
  "created_at": "2026-11-12T12:03:18+00:00",
  "updated_at": "2026-11-12T12:03:18+00:00"
 },
 "blocks": [
  {
   "type": "heading",
   "level": 1,
   "sentences": [
    {
     "text": "雨の日",
     "translation": "Un día de lluvia",
     "chunks": [
      {
       "text": "雨の日",
       "gloss": "día de lluvia",
       "note": "«の» une dos sustantivos: 雨 (lluvia) + の + 日 (día) = día de lluvia.",
       "translit": "ame no hi",
       "reading": "あめのひ"
      }
     ]
    }
   ]
  },
  {
   "type": "paragraph",
   "sentences": [
    {
     "text": "今日は雨が降っています。",
     "translation": "Hoy está lloviendo.",
     "chunks": [
      {
       "text": "今日は",
       "gloss": "hoy",
       "note": "今日 tiene lectura especial: きょう. La partícula は marca el tema y se pronuncia «wa».",
       "translit": "kyō wa",
       "reading": "きょうは"
      },
      {
       "text": "雨が",
       "gloss": "la lluvia",
       "note": "が marca el sujeto gramatical de 降る.",
       "translit": "ame ga",
       "reading": "あめが"
      },
      {
       "text": "降っています。",
       "gloss": "está cayendo",
       "note": "Con la lluvia y la nieve se usa 降る (caer): 雨が降る = llover.",
       "translit": "futte imasu",
       "reading": "ふっています",
       "lemma": "降る",
       "grammar": "forma て + います · acción en curso"
      }
     ]
    },
    {
     "text": "窓の外を見ながら、お茶を飲みます。",
     "translation": "Mientras miro por la ventana, me tomo un té.",
     "chunks": [
      {
       "text": "窓の外を",
       "gloss": "el exterior de la ventana",
       "note": "窓 (ventana) の 外 (exterior). を marca el objeto directo de 見る.",
       "translit": "mado no soto o",
       "reading": "まどのそとを"
      },
      {
       "text": "見ながら、",
       "gloss": "mientras miro,",
       "note": "〜ながら une dos acciones simultáneas del mismo sujeto; la acción principal va al final.",
       "translit": "minagara",
       "reading": "みながら",
       "lemma": "見る",
       "grammar": "raíz + ながら · simultaneidad"
      },
      {
       "text": "お茶を",
       "gloss": "té",
       "note": "お es un prefijo de cortesía muy habitual con ciertas palabras: お茶, お水.",
       "translit": "ocha o",
       "reading": "おちゃを"
      },
      {
       "text": "飲みます。",
       "gloss": "bebo",
       "note": "El presente japonés sirve también para hábitos y futuro próximo.",
       "translit": "nomimasu",
       "reading": "のみます",
       "lemma": "飲む",
       "grammar": "forma ます · presente cortés"
      }
     ]
    }
   ]
  }
 ]
}