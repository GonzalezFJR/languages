# Application
APP_NAME=Lextor
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Content storage (relative to project root). Never served raw over HTTP.
CONTENTS_DIR=static/contents

# Admin login
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Public absolute URL of this deployment, used in links returned to AI assistants via MCP
# (e.g. https://lextor.example.com). Leave empty to derive it from each request.
PUBLIC_URL=

# Allowed Origin headers for the MCP endpoint (comma-separated, * = any)
MCP_ALLOWED_ORIGINS=*

# Allow MCP connections without a personal token to create texts (saved as public links). Set to false
# on private deployments so only personal connector URLs can write.
MCP_ALLOW_ANONYMOUS=true
